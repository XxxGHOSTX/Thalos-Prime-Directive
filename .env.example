# Thalos Prime immersive interface - safe local development defaults
THALOS_ENV=development
THALOS_DEBUG=false

# This legacy interface is intentionally loopback-only.
THALOS_API_HOST=127.0.0.1
THALOS_API_PORT=8000
THALOS_API_WORKERS=1

# Explicit browser origins. CORS is not authentication.
THALOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Do not place real credentials in this file.
# Configure secrets through a local secret manager or environment variables.
THALOS_SECRET_KEY=
THALOS_API_KEY=

THALOS_STORAGE_TYPE=memory
THALOS_STORAGE_PATH=./data/storage.json
THALOS_LOG_LEVEL=INFO

THALOS_CIS_ENABLED=true
THALOS_MEMORY_ENABLED=true
THALOS_CODEGEN_ENABLED=true

THALOS_CLI_ENABLED=true
THALOS_API_ENABLED=true
